{
  "name": "mastra-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "call": "tsx --env-file=.env scripts/call-todo-agent.ts",
    "structured": "tsx --env-file=.env scripts/structured-output.ts",
    "call:memory": "tsx --env-file=.env scripts/call-todo-agent-memory.ts",
    "threads": "tsx --env-file=.env scripts/list-todo-threads.ts",
    "prune": "tsx --env-file=.env scripts/prune-storage.ts",
    "context": "tsx --env-file=.env scripts/call-with-context.ts"
  },
  "dependencies": {
    "@mastra/core": "1.65.0",
    "@mastra/libsql": "1.22.4",
    "@mastra/memory": "1.28.3",
    "@mastra/server": "1.65.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "latest",
    "mastra": "1.28.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
